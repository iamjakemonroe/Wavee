{
  "name": "wavee-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "node scripts/deploy.mjs",
    "icons": "node scripts/brand.mjs",
