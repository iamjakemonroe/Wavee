NODE_ENV=development
PORT=4000
API_PREFIX=/v1
CORS_ORIGIN=*
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public app origin (email confirmation links use ${FRONTEND_URL}/auth/callback). Must match Supabase Auth redirect allowlist.
FRONTEND_URL=http://localhost:5173
STORAGE_BUCKET_SONGS=songs
STORAGE_BUCKET_COVERS=covers
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_PLAYLIST_COVERS=playlist-covers
