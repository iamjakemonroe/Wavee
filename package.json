{
  "name": "wavee",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "build": "pnpm --filter wavee-frontend run build",
    "backend": "pnpm --filter wavee-backend run dev",
    "backend:typecheck": "pnpm --filter wavee-backend run typecheck",
    "frontend": "pnpm --filter wavee-frontend run dev",
    "frontend:typecheck": "pnpm --filter wavee-frontend run typecheck",
    "mobile": "pnpm --filter wavee-mobile run start",
    "mobile:typecheck": "pnpm --filter wavee-mobile run typecheck",
    "typecheck": "pnpm -r run typecheck"
  }
}
